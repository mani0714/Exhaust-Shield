# Copy to .env and fill in a real Groq key (starts with gsk_).
# Never commit .env.

EXTERNAL_AI_MODE=live
EXTERNAL_AI_BASE_URL=https://api.groq.com/openai/v1
EXTERNAL_AI_API_KEY=gsk_YOUR_KEY_HERE
EXTERNAL_AI_MODEL=openai/gpt-oss-120b
EXTERNAL_AI_FALLBACK_MODEL=openai/gpt-oss-20b
EXTERNAL_AI_LIVE_SEARCH=1
